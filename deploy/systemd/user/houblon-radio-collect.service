[Unit]
Description=Houblon FM - collecte des sources
Documentation=file:///home/florian/bsc-app/radio/docs/DEPLOYMENT.md

[Service]
Type=oneshot
WorkingDirectory=/home/florian/bsc-app/radio
Environment=PATH=/home/florian/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock --wait 21600 /home/florian/bsc-app/radio/data/scheduler.lock /home/florian/.local/bin/uv run radio collect
TimeoutStartSec=infinity
